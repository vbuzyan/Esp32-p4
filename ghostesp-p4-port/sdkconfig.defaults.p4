CONFIG_LV_DISPLAY_USE_DC=y
CONFIG_LV_DISP_PIN_DC=16
CONFIG_LV_DISP_USE_RST=y
CONFIG_LV_DISP_PIN_RST=5
# CONFIG_LV_DISP_BACKLIGHT_OFF is not set
CONFIG_LV_DISP_BACKLIGHT_SWITCH=y
# CONFIG_LV_DISP_BACKLIGHT_PWM is not set
CONFIG_LV_BACKLIGHT_ACTIVE_LVL=y
CONFIG_LV_DISP_PIN_BCKL=32
CONFIG_LV_I2C=y
CONFIG_LV_I2C_DISPLAY_PORT=0
CONFIG_LV_TOUCH_CONTROLLER=7
# CONFIG_LV_TOUCH_CONTROLLER_NONE is not set
# CONFIG_LV_TOUCH_CONTROLLER_XPT2046 is not set
# CONFIG_LV_TOUCH_CONTROLLER_FT6X06 is not set
# CONFIG_LV_TOUCH_CONTROLLER_STMPE610 is not set
# CONFIG_LV_TOUCH_CONTROLLER_ADCRAW is not set
# CONFIG_LV_TOUCH_CONTROLLER_FT81X is not set
# CONFIG_LV_TOUCH_CONTROLLER_RA8875 is not set
CONFIG_LV_TOUCH_CONTROLLER_GT911=y
CONFIG_LV_I2C_TOUCH=y
# CONFIG_LV_GT911_SWAPXY is not set
# CONFIG_LV_GT911_INVERT_X is not set
# CONFIG_LV_GT911_INVERT_Y is not set
CONFIG_LV_I2C_TOUCH_PORT_0=y
# CONFIG_LV_I2C_TOUCH_PORT_1 is not set
CONFIG_LV_I2C_TOUCH_PORT=0

# 16MB OTA partition layout (app is 3.26MB; needs >3MB slots)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota_16mb.csv"

# ESP-Hosted (C6 WiFi coprocessor) needs 1000 Hz FreeRTOS tick
CONFIG_FREERTOS_HZ=1000

# Shrink esp-hosted SDIO RX buffers (streaming mode over-allocates internal DMA
# RAM and asserts at boot). We do not need the C6 link for the GhostLink relay.
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=n
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=8
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=8

# Screen OFF for now: GhostESP display manager uses SPI/RGB drivers; the EK79007
# MIPI-DSI panel needs a DSI path wired into GhostESP LVGL (next task). Headless
# boot (serial CLI) confirms the core port is stable.
CONFIG_WITH_SCREEN=y

# Re-enable screen: EK79007 DSI now wired into GhostESP display_manager.
CONFIG_WITH_SCREEN=y
# DSI panel takes native RGB565 byte order (no swap; swap is for the SPI panels)
CONFIG_LV_COLOR_16_SWAP=n

# Enable GhostESP touch polling (GT911 read wired in display_manager for P4)
CONFIG_USE_TOUCHSCREEN=y

# --- Onboard ESP32-C6 WiFi via esp-hosted (Elecrow V1.0 verified wiring) ---
# Backlight is GPIO31 (not GhostESP's default 32); GPIO32 is the C6 SDIO reset.
CONFIG_LV_DISP_PIN_BCKL=31
# esp-hosted SDIO link to the C6 — values from Elecrow's working WiFi lesson:
CONFIG_ESP_HOSTED_SDIO_1_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=1
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=32
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=1500
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y

# --- BLE over the onboard C6 (esp-hosted VHCI, not UART HCI) ---
# GhostESP defaults NimBLE to a UART HCI transport, which aborts on P4
# ("UART driver already installed"). Route NimBLE's HCI over esp-hosted's VHCI
# to the C6 controller instead.
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
