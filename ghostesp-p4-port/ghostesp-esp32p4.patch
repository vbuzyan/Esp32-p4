@@ -473,6 +622,10 @@ static void invert_flush_cb(lv_disp_drv_t *drv, const lv_area_t *area,
     m5stack_lvgl_render_callback(drv, area, color_p);
 #elif defined(CONFIG_USE_TDISPLAY_S3)
     i80_display_flush_cb(drv, area, color_p);
+#elif defined(CONFIG_IDF_TARGET_ESP32P4)
+    /* Copy the LVGL partial buffer into the DSI frame buffer; flush-ready is
+     * signaled from p4_dsi_color_done when the DMA2D transfer completes. */
+    esp_lcd_panel_draw_bitmap(s_p4_panel, area->x1, area->y1, area->x2 + 1, area->y2 + 1, color_p);
 #else
     disp_driver_flush(drv, area, color_p);
 #endif
@@ -803,12 +956,40 @@ bool isCharging() { return _isCharging; }
  * @param is_charging Pointer to store charging status
