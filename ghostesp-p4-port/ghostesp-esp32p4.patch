+# boot (serial CLI) confirms the core port is stable.
+CONFIG_WITH_SCREEN=y
+
+# Re-enable screen: EK79007 DSI now wired into GhostESP display_manager.
+CONFIG_WITH_SCREEN=y
+# DSI panel takes native RGB565 byte order (no swap; swap is for the SPI panels)
+CONFIG_LV_COLOR_16_SWAP=n
+
+# Enable GhostESP touch polling (GT911 read wired in display_manager for P4)
+CONFIG_USE_TOUCHSCREEN=y
+
+# --- Onboard ESP32-C6 WiFi via esp-hosted (Elecrow V1.0 verified wiring) ---
+# Backlight is GPIO31 (not GhostESP's default 32); GPIO32 is the C6 SDIO reset.
+CONFIG_LV_DISP_PIN_BCKL=31
+# esp-hosted SDIO link to the C6 — values from Elecrow's working WiFi lesson:
+CONFIG_ESP_HOSTED_SDIO_1_BIT_BUS=y
+CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=1
+CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
+CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
+CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
+CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
+CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=32
+CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
+CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=1500
+CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
+
+# --- BLE over the onboard C6 (esp-hosted VHCI, not UART HCI) ---
+# GhostESP defaults NimBLE to a UART HCI transport, which aborts on P4
+# ("UART driver already installed"). Route NimBLE's HCI over esp-hosted's VHCI
+# to the C6 controller instead.
+CONFIG_BT_NIMBLE_TRANSPORT_UART=n
+CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
+CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
