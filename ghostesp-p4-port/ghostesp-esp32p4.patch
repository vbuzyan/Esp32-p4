--- a/main/managers/display_manager.c
+++ b/main/managers/display_manager.c
@@ -456,6 +456,155 @@ static void gpio_isr_handler(void* arg) {
 }
 #endif
 
+#if defined(CONFIG_IDF_TARGET_ESP32P4)
+/* --- ESP32-P4 CrowPanel 9" V1.0: EK79007 MIPI-DSI panel -------------------
+ * GhostESP's stock display path (lvgl_esp32_drivers) only drives SPI/RGB
+ * panels; this board is MIPI-DSI. We bring the panel up directly with esp_lcd
+ * and feed GhostESP's LVGL flush via esp_lcd_panel_draw_bitmap, signaling
+ * flush-ready from the DPI DMA-completion callback (registered before the LVGL
+ * task starts — the ordering that esp_lvgl_port gets wrong on IDF 6.0.2). */
+#include "driver/gpio.h"
+#include "esp_ldo_regulator.h"
+#include "esp_lcd_mipi_dsi.h"
+#include "esp_lcd_panel_ops.h"
+#include "esp_lcd_ek79007.h"
+
+#define P4_LCD_H_RES 1024
+#define P4_LCD_V_RES 600
+#define P4_LCD_BLIGHT_GPIO 31
+static esp_lcd_panel_handle_t s_p4_panel = NULL;
+
+static bool p4_dsi_color_done(esp_lcd_panel_handle_t panel,
+                              esp_lcd_dpi_panel_event_data_t *edata, void *user_ctx) {
+    lv_disp_flush_ready((lv_disp_drv_t *)user_ctx);
+    return false;
+}
+
+static void p4_dsi_display_init(void) {
+    static esp_ldo_channel_handle_t ldo_phy = NULL, ldo_panel = NULL;
+    esp_ldo_channel_config_t phy = { .chan_id = 3, .voltage_mv = 2500 };  // DSI PHY
+    ESP_ERROR_CHECK(esp_ldo_acquire_channel(&phy, &ldo_phy));
+    esp_ldo_channel_config_t pan = { .chan_id = 4, .voltage_mv = 3300 };  // panel
+    ESP_ERROR_CHECK(esp_ldo_acquire_channel(&pan, &ldo_panel));
+
+    esp_lcd_dsi_bus_handle_t dsi_bus = NULL;
+    esp_lcd_dsi_bus_config_t bus_config = {
+        .bus_id = 0, .num_data_lanes = 2,
+        .phy_clk_src = MIPI_DSI_PHY_CLK_SRC_DEFAULT, .lane_bit_rate_mbps = 900,
+    };
+    ESP_ERROR_CHECK(esp_lcd_new_dsi_bus(&bus_config, &dsi_bus));
+
+    esp_lcd_panel_io_handle_t dbi_io = NULL;
+    esp_lcd_dbi_io_config_t dbi_config = { .virtual_channel = 0, .lcd_cmd_bits = 8, .lcd_param_bits = 8 };
+    ESP_ERROR_CHECK(esp_lcd_new_panel_io_dbi(dsi_bus, &dbi_config, &dbi_io));
+
+    esp_lcd_dpi_panel_config_t dpi_config = {
+        .dpi_clk_src = MIPI_DSI_DPI_CLK_SRC_DEFAULT, .dpi_clock_freq_mhz = 51,
+        .in_color_format = LCD_COLOR_FMT_RGB565, .out_color_format = LCD_COLOR_FMT_RGB565,
+        .num_fbs = 1,
+        .video_timing = { .h_size = P4_LCD_H_RES, .v_size = P4_LCD_V_RES,
+            .hsync_back_porch = 160, .hsync_pulse_width = 70, .hsync_front_porch = 160,
+            .vsync_back_porch = 23,  .vsync_pulse_width = 10, .vsync_front_porch = 12, },
+    };
+    ek79007_vendor_config_t vendor_config = { .mipi_config = { .dsi_bus = dsi_bus, .dpi_config = &dpi_config } };
+    esp_lcd_panel_dev_config_t panel_config = {
+        .reset_gpio_num = -1, .rgb_ele_order = LCD_RGB_ELEMENT_ORDER_RGB,
+        .bits_per_pixel = 16, .vendor_config = &vendor_config,
+    };
+    ESP_ERROR_CHECK(esp_lcd_new_panel_ek79007(dbi_io, &panel_config, &s_p4_panel));
+    ESP_ERROR_CHECK(esp_lcd_panel_reset(s_p4_panel));
+    ESP_ERROR_CHECK(esp_lcd_panel_init(s_p4_panel));
+    ESP_ERROR_CHECK(esp_lcd_dpi_panel_enable_dma2d(s_p4_panel));
+    // Backlight (GPIO31) is driven by GhostESP's backlight manager via
+    // CONFIG_LV_DISP_PIN_BCKL=31; GPIO32 is left free for the C6 SDIO reset.
+    ESP_LOGI(TAG, "P4 EK79007 DSI panel up (%dx%d)", P4_LCD_H_RES, P4_LCD_V_RES);
+}
+
+static void p4_dsi_register_flush_ready(lv_disp_drv_t *drv) {
+    esp_lcd_dpi_panel_event_callbacks_t cbs = { .on_color_trans_done = p4_dsi_color_done };
+    ESP_ERROR_CHECK(esp_lcd_dpi_panel_register_event_callbacks(s_p4_panel, &cbs, drv));
+}
+
+/* --- GT911 capacitive touch (feeds GhostESP's touch_data pipeline) --------- */
+#include "driver/i2c_master.h"
+#include "esp_lcd_touch_gt911.h"
+#define P4_TP_SCL 46
+#define P4_TP_SDA 45
+#define P4_TP_INT 42
+#define P4_TP_RST 40
+static esp_lcd_touch_handle_t s_p4_touch = NULL;
+static i2c_master_bus_handle_t s_p4_i2c_bus = NULL;   /* shared GT911 + STC8 bus */
+
+static void p4_touch_init(void) {
+    i2c_master_bus_config_t ic = {
+        .i2c_port = 0, .sda_io_num = P4_TP_SDA, .scl_io_num = P4_TP_SCL,
+        .clk_source = I2C_CLK_SRC_DEFAULT, .glitch_ignore_cnt = 7,
+        .flags.enable_internal_pullup = true,
+    };
+    if (i2c_new_master_bus(&ic, &s_p4_i2c_bus) != ESP_OK) { ESP_LOGE(TAG, "P4 touch I2C init failed"); return; }
+    esp_lcd_panel_io_handle_t tio = NULL;
+    esp_lcd_panel_io_i2c_config_t tcfg = ESP_LCD_TOUCH_IO_I2C_GT911_CONFIG();
+    ESP_ERROR_CHECK(esp_lcd_new_panel_io_i2c(s_p4_i2c_bus, &tcfg, &tio));
+    esp_lcd_touch_config_t tp = {
+        .x_max = P4_LCD_H_RES, .y_max = P4_LCD_V_RES,
+        .rst_gpio_num = P4_TP_RST, .int_gpio_num = P4_TP_INT,
+        .levels = { .reset = 0, .interrupt = 0 },
+    };
+    if (esp_lcd_touch_new_i2c_gt911(tio, &tp, &s_p4_touch) != ESP_OK) {
+        tcfg.dev_addr = ESP_LCD_TOUCH_IO_I2C_GT911_ADDRESS_BACKUP;
+        ESP_ERROR_CHECK(esp_lcd_new_panel_io_i2c(s_p4_i2c_bus, &tcfg, &tio));
+        ESP_ERROR_CHECK(esp_lcd_touch_new_i2c_gt911(tio, &tp, &s_p4_touch));
+    }
+    ESP_LOGI(TAG, "P4 GT911 touch ready");
+}
+
+/* --- STC8H1K08 (U14) battery co-processor: I2C slave @ 0x2F on the GT911 bus.
+ * Decoded register map (see ghostesp-p4-port): 0x08 = percent (0-100),
+ * 0x04/0x05 = voltage mV (uint16 LE), 0x09 = charging flag. */
+#define P4_STC8_ADDR   0x2F
+static i2c_master_dev_handle_t s_p4_stc8 = NULL;
+
+bool p4_stc8_battery_read(uint8_t *percent, uint16_t *millivolts, bool *charging) {
+    if (!s_p4_i2c_bus) return false;
+    if (!s_p4_stc8) {
+        i2c_device_config_t dc = { .dev_addr_length = I2C_ADDR_BIT_LEN_7,
+                                   .device_address = P4_STC8_ADDR, .scl_speed_hz = 100000 };
+        if (i2c_master_bus_add_device(s_p4_i2c_bus, &dc, &s_p4_stc8) != ESP_OK) return false;
+    }
+    /* This STC8 firmware doesn't auto-increment on multi-byte reads, so read
+     * each register with its own write-reg/read-byte transaction. */
+    uint8_t reg, v, lo = 0, hi = 0;
+    reg = 0x08;
+    if (i2c_master_transmit_receive(s_p4_stc8, &reg, 1, &v, 1, 100) != ESP_OK) return false;
+    if (percent) *percent = (v > 100) ? 100 : v;
+    if (millivolts) {
+        reg = 0x04;
+        if (i2c_master_transmit_receive(s_p4_stc8, &reg, 1, &lo, 1, 100) == ESP_OK) {
+            reg = 0x05;
+            if (i2c_master_transmit_receive(s_p4_stc8, &reg, 1, &hi, 1, 100) == ESP_OK)
+                *millivolts = (uint16_t)lo | ((uint16_t)hi << 8);
+        }
+    }
+    reg = 0x09;
+    if (charging && i2c_master_transmit_receive(s_p4_stc8, &reg, 1, &v, 1, 100) == ESP_OK)
+        *charging = (v == 0x01);   /* 0x01=charging, 0x02=no-battery/idle */
+    return true;
+}
+
+static void p4_gt911_read(lv_indev_data_t *data) {
+    uint16_t x = 0, y = 0, strength = 0; uint8_t n = 0;
+    if (s_p4_touch) {
+        esp_lcd_touch_read_data(s_p4_touch);
+        if (esp_lcd_touch_get_coordinates(s_p4_touch, &x, &y, &strength, &n, 1) && n > 0) {
+            data->state = LV_INDEV_STATE_PR;
+            data->point.x = x; data->point.y = y;
+            return;
+        }
+    }
+    data->state = LV_INDEV_STATE_REL;
+}
+#endif  /* CONFIG_IDF_TARGET_ESP32P4 */
+
 static void invert_flush_cb(lv_disp_drv_t *drv, const lv_area_t *area,
                             lv_color_t *color_p) {
