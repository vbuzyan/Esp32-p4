            (int)heap_caps_get_free_size(MALLOC_CAP_INTERNAL));
 
 #elif defined(CONFIG_JC3248W535EN_LCD)
@@ -3308,6 +3497,8 @@ void hardware_input_task(void *pvParameters) {
 
