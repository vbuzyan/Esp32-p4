            (int)heap_caps_get_free_size(MALLOC_CAP_INTERNAL));
 #endif // CONFIG_JC3248W535EN_LCD
 
@@ -1719,7 +1903,12 @@ ESP_LOGI(TAG, "T-Deck trackball ISRs registered");
   disp_drv.flush_cb = invert_flush_cb;
