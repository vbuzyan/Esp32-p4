+    // If the hosted C6 station wasn't ready yet, retry until it is (up to ~3s).
+    for (int attempt = 0; err == ESP_ERR_WIFI_STATE && attempt < 15; attempt++) {
+        vTaskDelay(pdMS_TO_TICKS(200));
+        err = esp_wifi_scan_start(&scan_config, true);
+    }
+#endif
 
     if (err != ESP_OK) {
         printf("WiFi scan failed to start: %s", esp_err_to_name(err));
