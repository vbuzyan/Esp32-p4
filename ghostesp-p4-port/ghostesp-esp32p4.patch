  */
+#if defined(CONFIG_IDF_TARGET_ESP32P4)
+bool p4_stc8_battery_read(uint8_t *percent, uint16_t *millivolts, bool *charging);
+#endif
+
 static bool get_battery_info(uint8_t *percentage, bool *is_charging) {
     bool result = false;
     if (!percentage || !is_charging) {
         return result;
     }
 
+#if defined(CONFIG_IDF_TARGET_ESP32P4)
+    // CrowPanel P4: battery is read from the STC8H1K08 co-processor over I2C.
+    {
+        uint8_t pct = 0; uint16_t mv = 0; bool chg = false;
+        if (p4_stc8_battery_read(&pct, &mv, &chg)) {
+            static bool logged_once = false;
+            if (!logged_once) {
+                logged_once = true;
+                ESP_LOGI(TAG, "STC8 battery @0x2F: %u%%, %umV, charging=%s",
+                         pct, mv, chg ? "yes" : "no");
+            }
+            // No battery: VBAT floats to the charger output (~4.4-4.6V), above
+            // any real LiPo (<=~4.25V). Treat >4300mV as "no battery" so the UI
+            // doesn't show a bogus 100%.
+            if (mv > 4300) {
+                return false;
+            }
+            *percentage = pct;
+            *is_charging = chg;
+            return true;
+        }
+    }
+#endif
+
     // Cache for non-fuel-gauge configurations to avoid I2C access in low mode
     static uint8_t last_pct_cache = 0;
     static bool last_chg_cache = false;
@@ -1601,10 +1782,13 @@ ESP_LOGI(TAG, "T-Deck trackball ISRs registered");
