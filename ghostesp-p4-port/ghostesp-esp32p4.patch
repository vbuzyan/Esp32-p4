+    vTaskDelay(pdMS_TO_TICKS(300));
+#endif
 
     wifi_scan_config_t scan_config = {
         .ssid = NULL,
@@ -292,6 +299,13 @@ void ap_scan_start(void) {
 #endif
 
     err = esp_wifi_scan_start(&scan_config, true);
